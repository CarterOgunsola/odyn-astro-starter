{
  "name": "odyn-astro-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal Astro starter for experiential sites: vanilla TypeScript, SCSS, GSAP, a transition conductor, lazy engines, and a Cloudflare Worker deploy. Born from Astro minimal.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "count": "node scripts/count.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run check && bun run lint && bun run format:check && bun run check:tokens && bun run test:unit && bun run build && bun run test:e2e",
    "test": "playwright test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:unit": "bun test tests/unit",
    "test:scaffold": "bun test tests/scaffold",
    "new": "node scripts/new.mjs",
    "add": "node scripts/add.mjs",
    "init": "node scripts/init.mjs",
    "release": "node scripts/release.mjs",
    "icon": "node scripts/add-icon.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@odyn/conductor": "workspace:*",
    "@odyn/devkit": "workspace:*",
    "@odyn/engines": "workspace:*",
    "@odyn/lifecycle": "workspace:*",
    "@odyn/reveal": "workspace:*",
    "astro": "7.3.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "sass": "1.104.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.130.0"
  },
  "starter": {
    "name": "odyn-astro-starter",
    "initialised": false,
    "ref": "v1.0.0",
    "head": null,
    "date": "2026-09-04"
  }
}
