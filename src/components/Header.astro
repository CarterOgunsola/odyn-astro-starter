---
import ThemeToggle from "@/components/ThemeToggle.astro";
import Mark from "@/icons/odyn.svg";
import { SITE } from "@/config/site";

const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header container" data-header transition:persist="header">
  <nav class="header__row" aria-label="Primary">
    <a class="header__brand text-tag" href="/" aria-label={`${SITE.name}, home`}>
      <Mark class="header__mark" width={18} height={18} aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>
    <ul class="header__nav" role="list">
      {
        SITE.nav.map((l) => (
          <li>
            <a class="text-nav" href={l.href} aria-current={active(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="header__toggle">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style lang="scss">
  @use "tokens" as tk;
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-block: var(--s-16);
  }
  .header__row {
    display: flex;
    align-items: center;
    gap: var(--s-24);
    @media (max-width: #{tk.bp(s)}) {
      flex-wrap: wrap;
      row-gap: var(--s-8);
      .header__nav {
        margin-inline-start: calc(-1 * var(--s-8));
      }
      .header__toggle {
        margin-inline-start: auto;
      }
    }
  }
  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-10);
    min-height: var(--hit);
    color: var(--ink);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }
  .header__mark {
    display: block;
  }
  .header__nav {
    display: flex;
    gap: var(--s-4);
    margin-inline-start: auto;
    a {
      display: inline-flex;
      align-items: center;
      min-height: var(--hit);
      padding-inline: var(--s-8);
      color: var(--ink-muted);
      transition: color 0.3s var(--ease-out-quad);
      &[aria-current="page"] {
        color: var(--ink);
      }
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .header__nav a:hover {
      color: var(--ink);
    }
  }
</style>
